# Copy to product/.env. The Pilot root .env is independent.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
FORMREADER_PUBLIC_URL=http://localhost:8088
# Generate each secret separately. Do not use the example names as passwords.
FORMREADER_SETUP_TOKEN=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# TextSense REST gateway and engine, reachable inside the customer network.
TEXTSENSE_BASE_URL=http://192.168.0.25:7777
TEXTSENSE_ENGINE_URL=http://textsense:8080
TEXTSENSE_TASK_NAME=formreader-product
# HTTP source fetch: use an internal Nginx URL reachable by TextSense.
# Leave empty when using a shared input folder instead.
FORMREADER_INPUT_PUBLIC_URL=
EPAPYRUS_INPUT_URI=file:///ePapyrus/data/input
EPAPYRUS_OUTPUT_URI=file:///ePapyrus/data/output
# FTP results: also apply compose.ftp.yaml to publish passive FTP ports.
FTP_ENABLED=false
FTP_PUBLIC_HOST=127.0.0.1
FTP_HOST_BIND_ADDRESS=127.0.0.1
FTP_PORT=2121
FTP_PASV_MIN=50000
FTP_PASV_MAX=50020
JOB_TIMEOUT_MS=120000
OUTPUT_FILE_WAIT_MS=30000
TEXTSENSE_CANCEL_PATH=
