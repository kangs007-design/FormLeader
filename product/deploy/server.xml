<?xml version="1.0" encoding="UTF-8"?>
<Server port="-1">
  <Service name="Catalina">
    <!-- Expose this connector only to the Nginx host/network. -->
    <Connector port="8080" protocol="HTTP/1.1" connectionTimeout="20000"
      maxThreads="100" maxPostSize="1048576" URIEncoding="UTF-8" server="FormReader"/>
    <Engine name="Catalina" defaultHost="localhost">
      <Host name="localhost" appBase="webapps" unpackWARs="true" autoDeploy="false" deployOnStartup="true">
        <Valve className="org.apache.catalina.valves.RemoteIpValve"
          internalProxies="127\.0\.0\.1|::1|172\.(1[6-9]|2[0-9]|3[01])\.\d{1,3}\.\d{1,3}"
          remoteIpHeader="X-Forwarded-For" protocolHeader="X-Forwarded-Proto"/>
      </Host>
    </Engine>
  </Service>
</Server>
