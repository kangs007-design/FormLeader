# ---- DigitalLeader web server ----
FORMREADER_PORT=3000

# ---- TextSense (ePapyrus) 연결 : textsense.py 와 동일 값 ----
TEXTSENSE_HOST=192.168.0.25
TEXTSENSE_PORT=7777
TEXTSENSE_BUILD_PATH=/textsense/api/job/build
# TextSense 엔진 내부 주소 (ePapyrus 컨테이너 기준)
TEXTSENSE_ENGINE_URL=http://textsense:8080
TEXTSENSE_TASK_NAME=simple-conversion-sample

# ---- ePapyrus 서버 입출력 경로 (서버 기준 URI / DigitalLeader 기준 로컬 경로) ----
# 두 경로는 같은 스토리지(공유 폴더, 마운트)를 가리켜야 합니다.
EPAPYRUS_INPUT_URI=file:///ePapyrus/data/input
EPAPYRUS_OUTPUT_URI=file:///ePapyrus/data/output
LOCAL_INPUT_DIR=./data/input
LOCAL_OUTPUT_DIR=./data/output

# ---- 공유 폴더 없이 사용 (VPN 권장): 입력은 HTTP, 결과는 FTP 로 전달 ----
# TextSense 서버가 이 PC 에 접속할 수 있어야 한다. (입력: http://이PC:3000/files/input/..., 결과: ftp://이PC:2121/...)
# auto = TextSense 로 나가는 경로의 이 PC 주소를 작업마다 자동 감지 (OpenVPN 처럼 접속할 때마다 주소가 바뀌는 환경)
# 고정 주소를 쓰려면 http://192.168.5.5:3000 처럼 직접 지정
# 입력 파일은 작업마다 생성하는 유효기간 있는 서명 URL로 전달합니다.
# FORMREADER_PUBLIC_URL=auto
# FTP_ENABLED=true
# FTP_PUBLIC_HOST=auto
# FTP_PORT=2121
# FTP_PASV_MIN=50000
# FTP_PASV_MAX=50020
# FTP_USER=formreader
# FTP_PASSWORD=        # 비우면 실행할 때마다 임의 생성

# ---- 동작 옵션 ----
REQUEST_TIMEOUT_MS=15000
JOB_TIMEOUT_MS=120000
JOB_POLL_INTERVAL_MS=1000
# 작업 성공 후 결과 파일이 공유 저장소에 나타나길 기다리는 시간
OUTPUT_FILE_WAIT_MS=30000
# PDF 원본의 72dpi 기준 OCR 좌표 배율 (현재 서버 실측 2)
PDF_OCR_SCALE=2
# 별도로 확인된 엔진 중단 API가 있을 때만 설정 (POST {type:"OBJECT_ID",id})
# TEXTSENSE_CANCEL_PATH=

# ---- 로그인 / 회원가입 / 사용자 관리 ----
# 최초 관리자는 서버 PC의 http://localhost:3000 에서 직접 생성합니다.
# 이후 가입자는 관리자가 승인해야 로그인할 수 있습니다.
# AUTH_SECRET=             # 32자 이상. 비워두면 data/.auth-secret 에 자동 생성/보관
# AUTH_BASE_URL=https://ocr.example.com  # HTTPS 운영 시 실제 접속 주소
